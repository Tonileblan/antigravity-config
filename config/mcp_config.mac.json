{
  "mcpServers": {
    "stitch": {
      "command": "/usr/local/bin/node",
      "args": [
        "__CONFIG_DIR__/tools/stitch-mcp/index.js"
      ]
    },
    "macos-control": {
      "command": "/usr/local/bin/node",
      "args": [
        "/Users/toni/Proyectos/Flowmind/tools/macos-control/index.js"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "__SUPABASE_ACCESS_TOKEN__"
      }
    },
    "vercel": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.vercel.com"
      ]
    },
    "notebooklm": {
      "command": "npx",
      "args": [
        "-y",
        "notebooklm-mcp@latest"
      ]
    }
  }
}
