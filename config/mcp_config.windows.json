{
  "mcpServers": {
    "stitch": {
      "command": "node",
      "args": [
        "__CONFIG_DIR__\\tools\\stitch-mcp\\index.js"
      ]
    },
    "notebook": {
      "command": "node",
      "args": [
        "__CONFIG_DIR__\\tools\\notebook-mcp\\index.js"
      ]
    },
    "supabase": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "__SUPABASE_ACCESS_TOKEN__"
      }
    }
  }
}

